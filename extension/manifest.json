{
  "manifest_version": 3,
  "name": "Diabetes AI - PDF Scanner & Risk Predictor",
  "version": "1.0.0",
  "description": "Scan medical PDF lab reports & clinical values to get instant AI-powered diabetes risk prediction.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Scan Medical PDF & Predict Diabetes Risk"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "web_accessible_resources": [
    {
      "resources": ["pdf.worker.min.js", "pdf-parser.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
